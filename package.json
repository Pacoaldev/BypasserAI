{
  "name": "bypasser-ai",
  "version": "0.1.0",
  "description": "Pre-commit hook that detects AI-generated code patterns and rewrites them via any OpenAI-compatible API.",
  "type": "module",
  "bin": {
    "bypasser": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node scripts/test.js",
    "bench": "node --import tsx scripts/bench-detector.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "install-panel": "node integrations/opencode/install.mjs"
  },
  "files": [
    "dist",
    "integrations/opencode",
    "docs/SKILL.md",
    "docs/SKILL.en.md",
    "docs/SKILL.es.md",
    "assets/logo.png"
  ],
  "keywords": [
    "ai-detection",
    "humanizer",
    "git-hook",
    "pre-commit",
    "code-style"
  ],
  "author": "Pacoaldev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pacoaldev/BypasserAI.git"
  },
  "bugs": {
    "url": "https://github.com/Pacoaldev/BypasserAI/issues"
  },
  "homepage": "https://github.com/Pacoaldev/BypasserAI#readme",
  "dependencies": {
    "openai": "^4.52.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
